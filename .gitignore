# Python cache
__pycache__/
*.pyc

# Virtual environments
venv/
.env

# Rust build artifacts
shader_harness/target/

# Generated test outputs
# NOTE: gitignore does NOT support inline `# comment` after a pattern — the
# whole line becomes the pattern and matches nothing. Keep comments on
# their own lines.
# Legacy single-problem test outputs
llm_harness/test_*_results/
# Legacy multi-problem harness outputs
llm_harness/harness_*/*
# New multi-problem benchmark outputs (UUID-based)
llm_harness/benchmark_run_output/
# Same outputs if harness was invoked from repo root
benchmark_run_output/
# Generic output directory
output/
# Archived results
archive/

# MAINTENANCE NOTE: When adding new output directories, add them here immediately
# to prevent accidental commits of large result files (PNGs, logs, etc.)

# Images generated locally
llm_harness/images/
shader_harness/*.png

# OS files
.DS_Store
